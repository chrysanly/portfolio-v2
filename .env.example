# Example values only — THIS FILE IS COMMITTED TO GIT.
#
# Copy it to .env.local (or .env) and fill it in there. .env and .env.local are
# both in .gitignore; this file is not, so a real key typed here goes public
# with the next push.

# --- email (Phase 6 contact form) ---------------------------------------
#
# The contact form has two delivery paths and survives losing either one:
# it emails through Resend, and it posts a copy to the Laravel inbox. It only
# reports a failure to the sender when BOTH fail.
#
# Leave these empty and the form still works — the message goes to the admin
# inbox only, and the server log says why the email did not go.
#
# RESEND_API_KEY: https://resend.com/api-keys
# CONTACT_TO_EMAIL: where enquiries should land.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
NEXT_PUBLIC_SITE_URL=

# --- content source (Phase 8 backend) -----------------------------------
#
# Leave PORTFOLIO_API_URL EMPTY and the site builds from content/projects/*.mdx,
# exactly as it did before the backend existed. Nothing else is needed.
#
# Set it, and `npm run build` pulls from the Laravel API first and writes
# content/snapshot.json, which is committed. If the API is unreachable the build
# still succeeds off that snapshot — docs/08-BACKEND.md §2 "Build resilience".
#
# Local:  PORTFOLIO_API_URL=https://portfolio-api.test
# Live:   PORTFOLIO_API_URL=https://api.your-domain.com
#
PORTFOLIO_API_URL=
#
# Issued by the backend, shown once:
#   php artisan portfolio:build-token --email=you@example.com
#
# Its only ability is content:read. It cannot publish, delete, or read messages.
PORTFOLIO_API_TOKEN=
#
# How long to wait before giving up and using the snapshot. Optional.
PORTFOLIO_API_TIMEOUT=15000
#
# Local development only: Herd serves portfolio-api.test with a self-signed
# certificate, which Node refuses, so the contact form cannot reach the inbox
# locally without one of these. Neither belongs in production.
#
#   NODE_TLS_REJECT_UNAUTHORIZED=0 npm run dev        # blunt, dev only
#   NODE_EXTRA_CA_CERTS=<path to Herd's root CA>      # narrower
#
# Herd redirects http to https, so switching the scheme does not avoid it.
