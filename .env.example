# Example values only — THIS FILE IS COMMITTED TO GIT.
#
# Copy it to .env.local (or .env) and fill it in there. .env and .env.local are
# both in .gitignore; this file is not, so a real key typed here goes public
# with the next push.

# --- email (Phase 6 contact form) ---------------------------------------
#
# The contact form has two delivery paths and survives losing either one:
# it emails through Resend, and it posts a copy to the Laravel inbox. It only
# reports a failure to the sender when BOTH fail.
#
# Leave these empty and the form still works — the message goes to the admin
# inbox only, and the server log says why the email did not go.
#
# RESEND_API_KEY: https://resend.com/api-keys
# CONTACT_TO_EMAIL: where enquiries should land.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000/

# --- content source (required) ------------------------------------------
#
# The site's only content source is the Laravel API's GET /api/v1/content.
# There is no local fallback: with either of these missing or the API down,
# `npm run build` fails and says why. A running production server keeps
# serving its cached pages until /api/revalidate refreshes them.
#
# Local:  PORTFOLIO_API_URL=https://portfolio-api.test
# Live:   PORTFOLIO_API_URL=https://<your-api-host>
#
PORTFOLIO_API_URL=
#
# Issued by the backend, shown once:
#   php artisan portfolio:build-token --email=you@example.com
#
# Its only ability is content:read. It cannot publish, delete, or read messages.
PORTFOLIO_API_TOKEN=
#
# How long to wait for the API before failing, in milliseconds. Optional.
PORTFOLIO_API_TIMEOUT=15000

# --- live content updates -----------------------------------------------
#
# Shared with the backend. When a published project is saved, Laravel POSTs to
# /api/revalidate with this secret and the cached pages are regenerated from
# fresh content — no redeploy. The admin's "Sync site" button does the same.
#
# Any long random string; it must match SITE_REVALIDATE_SECRET in the API's
# .env. Generate one with:  openssl rand -hex 32
REVALIDATE_SECRET=

# --- local HTTPS (development only) -------------------------------------
#
# Herd and Valet serve .test domains with their own certificate authority,
# which Node does not trust by default, so every content fetch fails without
# this. `npm run dev|build|start` apply it before Node starts
# (scripts/with-ca.mjs). Certificate verification is never switched off.
#
# Windows (Herd):  C:/Users/<you>/.config/herd/config/valet/CA/LaravelValetCASelfSigned.crt
# macOS (Valet):   ~/.config/valet/CA/LaravelValetCASelfSigned.pem
NODE_EXTRA_CA_CERTS=
